# ---- LOCAL DEVELOPMENT (defaults) ----
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Leave empty locally: keys are auto-generated into ./data/.keys
JWT_SECRET=
MASTER_KEY=
# Optional: "Continue with Google". Without these the button explains it is not connected yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- PRODUCTION: on the server set ----
# NODE_ENV=production
# APP_URL=https://yourdomain.com          (no trailing slash; used for share links and Google)
# JWT_SECRET=   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MASTER_KEY=   same command; exactly 64 hex chars. BACK IT UP OFFLINE: if lost, every file is unrecoverable
# GOOGLE_CLIENT_ID=...   GOOGLE_CLIENT_SECRET=...
