PORT=3000
APP_URL=http://localhost:3000
# Leave empty in dev (auto-generated into ./data/.keys). REQUIRED in production:
JWT_SECRET=
MASTER_KEY=            # 64 hex chars: openssl rand -hex 32
# Payments (Stripe). Without keys, DEMO_BILLING=true lets you switch plans for testing ONLY.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
DEMO_BILLING=true
# Google sign-in (optional). Create an OAuth client in Google Cloud Console and add redirect URI: APP_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
