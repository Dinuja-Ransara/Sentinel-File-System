# Database Connection
ConnectionStrings__DefaultConnection="Host=localhost;Database=sentinel_db;Username=postgres;Password=yourpassword"

# JWT Settings
Jwt__SecretKey="YOUR_SUPER_SECRET_KEY_MIN_32_BYTES"
Jwt__Issuer="SentinelApi"
Jwt__Audience="SentinelClient"

# Storage Path
Storage__UploadDir="./uploads"